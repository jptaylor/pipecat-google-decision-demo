# Copy to .env for local runs. On Pipecat Cloud these go in the agent's secret set.

# The Gemini API key Google's Decisions API is asked with. Required.
GOOGLE_API_KEY=

# The longest a session lasts, in seconds. Optional: 600 by default.
# SESSION_MAX_SECS=600

# Only for running locally over Daily (`uv run bot.py -t daily`): the runner creates rooms with it.
# DAILY_API_KEY=
