# Copy to .env.local. Only VITE_ variables reach the browser: never put a secret in one.

# Which Pipecat transport the page connects with: "daily" (the hosted demo, the
# default) or "smallwebrtc" (local development against bot.py, no Daily account).
VITE_TRANSPORT=smallwebrtc

# Development only: where `npm run dev` proxies /api to. The bot's runner.
BOT_URL=http://localhost:7860

# The deployed agent's name and a Pipecat Cloud public API key that can start it,
# read by api/start.ts on the server, never by the page. Set them on the host in
# production. Set here, they make `npm run dev` start sessions on Pipecat Cloud
# over Daily instead of the local bot: leave VITE_TRANSPORT unset with them.
# PIPECAT_CLOUD_AGENT_NAME=google-perception-demo
# PIPECAT_CLOUD_PUBLIC_KEY=
